# Copia este archivo como .env y completa los valores. El .env y el wallet NO se suben al repositorio.
ORACLE_TNS_ALIAS=<alias del tnsnames.ora, ej. gymflowdb_high>
# Carpeta del wallet descomprimido. En Docker se monta como volumen de solo lectura en /app/wallet.
ORACLE_WALLET_DIR=/app/wallet
ORACLE_USER=<usuario>
ORACLE_PASSWORD=<contraseña>
# "update" crea las tablas la primera vez; luego se puede usar "validate".
JPA_DDL_AUTO=update
# URL interna de ms-gymflow-catalog (nombre del contenedor en Docker Compose)
CATALOG_URL=http://ms-gymflow-catalog:8082
