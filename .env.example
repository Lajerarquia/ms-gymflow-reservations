# Copia este archivo como .env y completa los valores. El .env NO se sube al repositorio.
# Amazon RDS PostgreSQL (instancia gymflow-db). La contraseña real va SOLO en el .env de la EC2.
DB_URL=jdbc:postgresql://<endpoint-rds>:5432/gymflow?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=<contraseña>
# "update" crea las tablas la primera vez; luego se puede usar "validate".
JPA_DDL_AUTO=update
# URL interna de ms-gymflow-catalog (nombre del contenedor en Docker Compose)
CATALOG_URL=http://ms-gymflow-catalog:8082
